# ===========================
# Grids & Circles - Root .gitignore
# ===========================

# ----- OS & Editor -----
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~

# JetBrains (IntelliJ IDEA)
.idea/
*.iml
*.iws
*.ipr

# VS Code
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Eclipse
.classpath
.project
.settings/

# ----- Frontend (React + Vite) -----
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.env
frontend/.env.local
frontend/.env.*.local
frontend/*.local
frontend/coverage/

# ----- Backend (Spring Boot + Gradle/Maven) -----
# Maven
backend/target/
backend/*.jar
backend/*.war

# Gradle
backend/build/
backend/.gradle/
backend/bin/
backend/out/

# Spring Boot
backend/src/main/resources/application-local.properties
backend/src/main/resources/application-secret.properties

# ----- Environment & Secrets -----
# 환경 변수 및 민감 정보 (JWT Secret, Gmail SMTP 등)
.env
.env.*
!.env.example
*.secret
*.key
*.pem

# ----- Docker -----
# Docker Compose override (로컬 전용 설정)
docker-compose.override.yml

# ----- Logs -----
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
spring.log

# ----- Misc -----
*.class
*.bak
*.tmp
*.temp
